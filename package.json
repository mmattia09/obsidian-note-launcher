{
	"name": "obsidian-note-launcher",
	"version": "1.0.1",
	"description": "Custom ribbon buttons that create notes from templates in a chosen folder",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src --max-warnings 0",
		"test": "node --test tests/*.test.mjs",
		"check": "npm run lint && npm test && npm run build"
	},
	"type": "commonjs",
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"esbuild": "^0.28.1",
		"eslint": "^10.13.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "1.14.4",
		"typescript": "~6.0.3"
	},
	"private": true,
	"engines": {
		"node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
	},
	"overrides": {
		"obsidian": "$obsidian"
	}
}
